  "bugs": {
    "url": "https://github.com/DataCoveEU/STAM/issues"
  },
  "homepage": "https://github.com/DataCoveEU/STAM#readme",
  "devDependencies": {
    "@types/events": "^3.0.3",
    "@types/leaflet": "^1.9.22",
    "all-contributors-cli": "^6.26.1",
    "babel-plugin-transform-class": "^0.3.0",
    "events": "^3.3.0",
    "leaflet-realtime": "^2.2.0",
    "picomodal": "^3.0.0",
    "semantic-release": "^25.0.9",
    "tsdown": "0.22.14",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "whatwg-fetch": "^3.6.20"
  },
