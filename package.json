{
  "name": "sta-map",
  "version": "0.0.0-development",
  "description": "OpenLayers and Leaflet Layer for integrating a SensorThings server",
  "files": [
    "dist",
    "CHANGELOG.md",
    "package.json",
    "README.md"
  ],
  "exports": {
    "./leaflet": "./dist/stam-leaflet.js",
    "./openlayers": "./dist/stam-openlayers.js"
  },
  "type": "module",
  "packageManager": "pnpm@12.0.0",
  "directories": {
    "doc": "docs"
  },
  "release": {
    "branches": [
      "main"
    ]
  },
  "scripts": {
    "build": "pnpm tsdown --minify",
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "watch": "pnpm tsdown --watch",
    "semantic-release": "semantic-release",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DataCoveEU/STAM.git"
  },
  "keywords": [
    "SensorThings",
    "Leaflet",
    "OpenLayers"
  ],
  "author": "Tobias Pressler",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/DataCoveEU/STAM/issues"
  },
  "homepage": "https://github.com/DataCoveEU/STAM#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/leaflet": "^1.9.22",
    "@vitest/coverage-v8": "^4.1.11",
    "all-contributors-cli": "^6.26.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.12",
    "leaflet": "^1.9.4",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "p-throttle": "^8.1.0",
    "picomodal": "^3.0.0",
    "prettier": "3.8.3",
    "semantic-release": "^25.0.9",
    "tsdown": "0.22.14",
    "tslib": "^2.8.1",
    "typescript": "npm:@typescript/typescript6",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "mqtt": "^5.15.2",
    "ol": "^10.10.0"
  }
}
